      "source": [
        "import numpy as np\n",
        "\n",
        "start = np.array([0, 0])\n",
        "goal = np.array([10, 10])\n",
        "\n",
        "particles = 20\n",
        "iterations = 50\n",
        "w, c1, c2 = 0.7, 1.5, 1.5\n",
        "\n",
        "positions = np.random.uniform(0, 10, (particles, 2))\n",
        "velocities = np.random.uniform(-1, 1, (particles, 2))\n",
        "\n",
        "\n",
        "def fitness(p):\n",
        "    return np.linalg.norm(p - goal)\n",
        "\n",
        "\n",
        "pbest = positions.copy()\n",
        "pbest_score = np.array([fitness(p) for p in positions])\n",
        "\n",
        "\n",
        "g = np.argmin(pbest_score)\n",
        "gbest = pbest[g].copy()\n",
        "\n",
        "for _ in range(iterations):\n",
        "    for i in range(particles):\n",
        "\n",
        "        r1, r2 = np.random.rand(), np.random.rand()\n",
        "\n",
        "        velocities[i] = (\n",
        "            w * velocities[i]\n",
        "            + c1 * r1 * (pbest[i] - positions[i])\n",
        "            + c2 * r2 * (gbest - positions[i])\n",
        "        )\n",
        "\n",
        "        positions[i] += velocities[i]\n",
        "        positions[i] = np.clip(positions[i], 0, 10)\n",
        "\n",
        "        score = fitness(positions[i])\n",
        "\n",
        "        if score < pbest_score[i]:\n",
        "            pbest[i] = positions[i].copy()\n",
        "            pbest_score[i] = score\n",
        "\n",
        "    g = np.argmin(pbest_score)\n",
        "    gbest = pbest[g].copy()\n",
        "\n",
        "print(\"Start Position:\", start)\n",
        "print(\"Goal Position:\", goal)\n",
        "print(\"Best Position Found:\", np.round(gbest, 2))\n",
        "print(\"Minimum Distance:\", round(fitness(gbest), 2))"
      ]
    }
